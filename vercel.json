{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "cleanUrls":true,
  "headers":[
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/app.js","headers":[{"key":"Cache-Control","value":"public, max-age=300, must-revalidate"}]},
    {"source":"/style.css","headers":[{"key":"Cache-Control","value":"public, max-age=3600, must-revalidate"}]},
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' https://script.google.com https://script.googleusercontent.com; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}
    ]}
  ]
}
